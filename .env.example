GEMINI_API_KEY=
GEMINI_MODEL=                 # optional, default gemini-3.5-flash-lite
GOOGLE_MAPS_API_KEY=          # Places (New) + Routes
ORS_API_KEY=
TRANSITLAND_API_KEY=
MBTA_API_KEY=                 # optional: works without, with a lower rate limit
MONGODB_URI=                  # optional in dev: in-memory cache/reports without it
MONGODB_DB=                   # optional, default eazyroam
TIGER_DATABASE_URL=           # Postgres connection string; optional in dev
USE_FIXTURES=0                # 1 = API routes return fixtures/*.json (dev only)
